# LegalLens AI — environment variables
# Copy to .env and fill in actual values. Never commit .env.

# Google Gemini API key (required for real AI analysis)
GEMINI_API_KEY=

# Optional: PostgreSQL connection string. If empty, the app uses a local SQLite file (ideal for demos).
DATABASE_URL=

# Secret used to sign any auth tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=http://localhost:5173

# Feature toggles
ENABLE_DEMO=true
# Run analysis in demo mode even for uploaded docs (avoids Gemini spend during testing)
FORCE_DEMO=false

# Logging
LOG_LEVEL=INFO

# Rate limiting (requests per minute per client IP for AI endpoints)
RATE_LIMIT_PER_MINUTE=30

# Upload limits
MAX_UPLOAD_SIZE_MB=20

# AI model configuration
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LITE_MODEL=gemini-3.6-flash-lite